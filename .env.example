# ---------------------------------------------------------------------------
# Nation-State Cyber Intelligence Dashboard - environment variables
# Copy to .env.local for local dev, or set in the Vercel project dashboard.
# ---------------------------------------------------------------------------

# Supabase project URL.
# Local (docker):  http://127.0.0.1:55321
# Hosted:          https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER-ONLY. Used exclusively by the ingest pipeline
# to write rows. Never import this into client components or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the `x-ingest-secret` header on POST /api/ingest.
# Vercel Cron is configured to send this. Generate a long random value in prod.
INGEST_CRON_SECRET=

# Access is managed entirely in Supabase Auth: any user that exists in the
# project may sign in (create/invite them in the Supabase dashboard and keep
# public sign-ups disabled). There is no application-level email allow-list.

# Optional. When set, enables the LLM enricher (Anthropic) in the ingest pipeline.
# When empty, the pipeline falls back to the rules-based enricher.
ANTHROPIC_API_KEY=

# Optional. When set, enables web-search augmentation in the ingest pipeline.
# When empty, the pipeline relies on RSS/Atom feeds only.
SEARCH_API_KEY=

# Optional. Reader-proxy base for pages a direct fetch cannot get (Cloudflare
# JS challenge / bot walls, e.g. Dark Reading). When set, blocked report URLs
# are routed through it to recover article text for the modal and IOC extraction.
# Off by default (no report URL leaves your servers unless set). Example (Jina):
#   READER_PROXY_URL=https://r.jina.ai/
READER_PROXY_URL=
# Optional bearer token for the reader proxy (higher rate limits).
READER_PROXY_KEY=

# Optional. Web-fetch triage (LLM enricher): cap on the tokens Claude's server-
# side web_fetch may ingest from one report page/PDF (default 8000), and a model
# override for the triage call (default claude-sonnet-5) via ANTHROPIC_MODEL.
WEB_FETCH_MAX_CONTENT_TOKENS=

# Optional. Ingest pacing. A batch is enriched, inserted and IOC-linked before
# the next starts, and the run-budget check only fires BETWEEN batches - so the
# first batch always completes and must fit inside the function's maxDuration
# (300s). Web-fetch triage runs ~60-100s per item, so keep a batch to roughly
# one concurrency wave. Defaults: batch 6, concurrency 6, budget 230000ms.
INGEST_BATCH_SIZE=
INGEST_ENRICH_CONCURRENCY=
INGEST_RUN_BUDGET_MS=
# Max self-chained ingest runs from one cron trigger (default 10). A run that
# stops on its time budget re-triggers itself until the backlog drains; this
# bounds the chain so a stuck candidate cannot loop and burn LLM calls.
INGEST_MAX_CHAIN=
# Model for the cheap stage-one triage screen (title/description only, no fetch)
# that filters obvious non-intelligence before the costly fetch pass.
ANTHROPIC_SCREEN_MODEL=
# Timeout for the one-per-run LLM calls (end-of-run reflection, executive
# summary). These are far larger than a per-item triage call; too small a value
# makes reflection time out and silently write no memory. Default 60000ms.
INGEST_LLM_LONG_TIMEOUT_MS=
